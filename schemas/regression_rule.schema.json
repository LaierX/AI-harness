{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LaierX/AI-harness/schemas/regression_rule.schema.json",
  "title": "Regression Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_uid",
    "rule_name",
    "scope",
    "target",
    "source_issue_uid",
    "trigger_condition",
    "expected_result",
    "verification_action",
    "executor_type",
    "severity",
    "status",
    "owner",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "rule_uid": { "$ref": "common.schema.json#/$defs/uid" },
    "rule_name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "scope": { "$ref": "common.schema.json#/$defs/regressionScope" },
    "target": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "source_issue_uid": { "$ref": "common.schema.json#/$defs/uid" },
    "trigger_condition": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "expected_result": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "verification_action": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "executor_type": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "severity": { "$ref": "common.schema.json#/$defs/regressionSeverity" },
    "status": { "$ref": "common.schema.json#/$defs/regressionRuleStatus" },
    "owner": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "created_at": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "updated_at": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "executor_config": { "type": "object", "additionalProperties": true },
    "schedule": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "timeout_sec": { "type": "integer", "minimum": 0 },
    "retry_policy": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "cooldown_sec": { "type": "integer", "minimum": 0 },
    "version": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "supersedes_rule_uid": { "$ref": "common.schema.json#/$defs/uid" },
    "disabled_reason": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "last_verified_at": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "valid_from": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "valid_to": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "schema_version": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
  }
}
