{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LaierX/AI-harness/schemas/governance_review_checklist.schema.json",
  "title": "Governance Review Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_uid",
    "review_scope",
    "evidence_range",
    "naming_drift_checked",
    "workflow_lifecycle_state_checked",
    "record_gate_bypass_checked",
    "regression_asset_executor_checked",
    "narrative_db_consistency_checked",
    "context_assembly_checked",
    "tool_contract_checked",
    "memory_layer_checked",
    "runtime_adapter_checked",
    "spec_gap",
    "context_gap",
    "tool_contract_gap",
    "memory_gap",
    "runtime_adapter_gap",
    "recommended_version",
    "recommended_patch_target",
    "readback_status"
  ],
  "properties": {
    "review_uid": { "$ref": "common.schema.json#/$defs/uid" },
    "review_scope": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "evidence_range": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "naming_drift_checked": { "type": "boolean" },
    "workflow_lifecycle_state_checked": { "type": "boolean" },
    "record_gate_bypass_checked": { "type": "boolean" },
    "regression_asset_executor_checked": { "type": "boolean" },
    "narrative_db_consistency_checked": { "type": "boolean" },
    "context_assembly_checked": { "type": "boolean" },
    "tool_contract_checked": { "type": "boolean" },
    "memory_layer_checked": { "type": "boolean" },
    "runtime_adapter_checked": { "type": "boolean" },
    "spec_gap": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "context_gap": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "tool_contract_gap": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "memory_gap": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "runtime_adapter_gap": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "recommended_version": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "recommended_patch_target": { "$ref": "common.schema.json#/$defs/textListOrObject" },
    "readback_status": { "$ref": "common.schema.json#/$defs/readbackStatus" },
    "schema_version": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
  }
}
