{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LaierX/AI-harness/schemas/tool_contract.schema.json",
  "title": "Tool Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tool_uid": { "$ref": "common.schema.json#/$defs/uid" },
    "tool_name": { "type": "string", "minLength": 1 },
    "tool_type": {
      "type": "string",
      "enum": ["read_only", "local_write", "environment_change", "external_call", "release_action"]
    },
    "owner_module": { "type": "string", "minLength": 1 },
    "input_schema": { "type": ["object", "array", "string"] },
    "output_schema": { "type": ["object", "array", "string"] },
    "side_effect_level": { "$ref": "common.schema.json#/$defs/sideEffectLevel" },
    "minimum_execution_profile": { "$ref": "common.schema.json#/$defs/executionProfile" },
    "timeout_policy": { "type": "string", "minLength": 1 },
    "retry_policy": { "type": "string", "minLength": 1 },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
    },
    "rollback_hint": { "type": "string", "minLength": 1 },
    "evidence_output": { "type": "string", "minLength": 1 },
    "artifact_output": { "type": "string", "minLength": 1 },
    "readback_method": { "type": "string", "minLength": 1 }
  },
  "required": [
    "tool_uid",
    "tool_name",
    "tool_type",
    "owner_module",
    "input_schema",
    "output_schema",
    "side_effect_level",
    "minimum_execution_profile",
    "timeout_policy",
    "retry_policy",
    "failure_modes",
    "rollback_hint",
    "evidence_output",
    "artifact_output",
    "readback_method"
  ]
}
